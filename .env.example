# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# Nothing in Phases 1-5 requires an API key: the local pipeline is fully offline
# after the models are downloaded once. Keys are only needed for the OPTIONAL
# LLM-assisted extraction path discussed in the LLM section.

# --- Optional: LLM-assisted structured extraction (Phase 5 / 6 fallback) ---
ANTHROPIC_API_KEY=

# --- Optional: override any config.yaml value via env ---
# Pattern: NEWSKG__<SECTION>__<KEY>  (double underscore = nesting)
# NEWSKG__PATHS__DATA_DIR=E:/Article-extarction-/data
# NEWSKG__NER__MODEL_NAME=dslim/bert-base-NER
# NEWSKG__LOGGING__LEVEL=DEBUG
